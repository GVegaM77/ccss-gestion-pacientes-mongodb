# Copie este archivo como .env y complete los valores. NUNCA suba .env a GitHub.
# Local (replica set de un nodo, necesario para transacciones):
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Produccion / Atlas (ejemplo): usuario con privilegios minimos + TLS
# MONGODB_URI=mongodb+srv://usuario_app:CONTRASENA@cluster.xxxxx.mongodb.net/
MONGODB_DB=ccss_pacientes
MONGODB_TLS=false
MONGODB_MAX_POOL=20
